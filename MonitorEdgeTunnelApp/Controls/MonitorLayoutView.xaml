<UserControl x:Class="MonitorEdgeTunnelApp.Controls.MonitorLayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Local="clr-namespace:MonitorEdgeTunnelApp.Controls"
             x:Name="Root">
    <UserControl.Resources>
        <Local:MonitorNumberConverter x:Key="MonitorNumberConverter"/>
        <Local:MonitorDescriptionConverter x:Key="MonitorDescriptionConverter"/>
    </UserControl.Resources>
    <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
            BorderBrush="Gainsboro" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="16">
                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Text="{Binding Items.Count, ElementName=MonitorList, StringFormat='{}{0} 部螢幕'}"/>
                <TextBlock Text="螢幕佈局" FontSize="16" FontWeight="SemiBold"/>
            </DockPanel>
            <Grid Grid.Row="1" Background="#171717" MinHeight="140">
                <ListBox x:Name="MonitorList" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemsSource="{Binding ItemsSource, ElementName=Root}"
                         SelectedValuePath="id" SelectedValue="{Binding SelectedMonitorId, ElementName=Root, Mode=TwoWay}"
                         SelectionMode="Single" ClipToBounds="True" AutomationProperties.Name="螢幕佈局">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter/>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Local:MonitorLayoutPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding id, Converter={StaticResource MonitorNumberConverter}, StringFormat='螢幕 {0}'}"/>
                            <Setter Property="ToolTip" Value="{Binding Converter={StaticResource MonitorDescriptionConverter}}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="MonitorBorder" Background="#303030" BorderBrush="#171717"
                                                BorderThickness="2" CornerRadius="5" ClipToBounds="True">
                                            <Viewbox Margin="8" Stretch="Uniform" StretchDirection="DownOnly">
                                                <TextBlock x:Name="MonitorNumber" Text="{Binding id, Converter={StaticResource MonitorNumberConverter}}"
                                                           Foreground="White" FontSize="32"/>
                                            </Viewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="MonitorBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                                <Setter TargetName="MonitorNumber" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <Local:TunnelOverlay x:Name="TunnelMarks"/>
                <TextBlock x:Name="EmptyLayoutMessage" Text="目前沒有可顯示的螢幕資訊" Foreground="Gainsboro"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=MonitorList}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <WrapPanel Grid.Row="2" Margin="16,10,16,0">
                <TextBlock Text="━━ 傳送通道" Foreground="#168061" Margin="0,0,14,4"/>
                <TextBlock Text="┄ 禁止通行" Foreground="#B02D40" Margin="0,0,14,4"/>
                <TextBlock Text="┄ 設定異常" Foreground="#8A5900" Margin="0,0,0,4"/>
            </WrapPanel>
            <ScrollViewer x:Name="PreviewDetails" Grid.Row="3" Margin="16" MaxHeight="140"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="規則預覽（目前編輯內容）" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="SelectedTunnelLabel" Text="{Binding SelectedTunnelDescription, ElementName=Root}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Expander x:Name="PreviewWarnings" Header="{Binding PreviewWarningSummary, ElementName=Root}" Margin="0,0,0,10">
                        <Expander.Style>
                            <Style TargetType="Expander">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasWarnings, ElementName=Root}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <ItemsControl ItemsSource="{Binding PreviewMessages, ElementName=Root}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="NoticeClicked" Tag="{Binding Rule}" Background="Transparent" BorderThickness="0"
                                            HorizontalContentAlignment="Left" Padding="4" AutomationProperties.Name="{Binding Text}">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <ContentControl Content="{Binding SelectedItem, ElementName=MonitorList}"
                                    HorizontalContentAlignment="Stretch" MinHeight="40">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding id, Converter={StaticResource MonitorNumberConverter}, StringFormat='已選取螢幕 {0}'}"/>
                                    <TextBlock Text="{Binding Converter={StaticResource MonitorDescriptionConverter}}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
