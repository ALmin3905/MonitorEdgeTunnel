<Window x:Class="MonitorEdgeTunnelApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        xmlns:Local="clr-namespace:MonitorEdgeTunnelApp"
        xmlns:Controls="clr-namespace:MonitorEdgeTunnelApp.Controls"
        xmlns:Editing="clr-namespace:MonitorEdgeTunnelApp.Editing"
        mc:Ignorable="d"
        Title="螢幕邊界助手" Height="780" Width="1280" MinHeight="600" MinWidth="860"
        Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ObjectDataProvider x:Key="NameFromEdgeTypeEnum" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="Local:EdgeType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="NameFromRangeTypeEnum" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="Local:RangeType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <Local:TunnelInfo_Notify x:Key="TunnelInfo_Notify"/>
        <Local:RelativeIdValidMultiValueConverter x:Key="RelativeIdValidMultiValueConverter"/>
        <Local:IsStartConverter x:Key="IsStartConverter"/>
        <Editing:EditorOptionLabelConverter x:Key="EditorOptionLabelConverter"/>
        <Controls:MonitorNumberConverter x:Key="MonitorNumberConverter"/>
        <Controls:MonitorDescriptionConverter x:Key="MonitorDescriptionConverter"/>
        <Style x:Key="SummaryListItem" TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Chrome" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="WorkspaceRoot" Background="{DynamicResource AppBackgroundBrush}" TextElement.Foreground="{DynamicResource TextBrush}"
          TextElement.FontFamily="Segoe UI, Microsoft JhengHei UI" TextElement.FontSize="13">
        <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="24,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MONITOR EDGE TUNNEL" Style="{StaticResource Caption}" FontSize="10" Margin="0,0,0,5"/>
                <TextBlock Text="螢幕與通道" FontSize="22" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="IdentifyMonitorsButton" Content="{Binding IdentifyMonitorsCaption}" IsEnabled="{Binding CanIdentifyMonitors}" Click="IdentifyMonitorsButton_Click"
                        Style="{StaticResource QuietButton}" Margin="0,0,12,0" ToolTip="在各實體螢幕顯示編號 10 秒；Esc 或再次點擊可結束" AutomationProperties.Name="辨識實體螢幕"/>
                <Border CornerRadius="12" Background="{DynamicResource SidebarBrush}" Padding="10,5" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource MutedTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding isStart}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="尚未啟動"/><Style.Triggers><DataTrigger Binding="{Binding isStart}" Value="True"><Setter Property="Text" Value="通道運作中"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </StackPanel>
                </Border>
                <Menu VerticalAlignment="Center">
                    <MenuItem Header="選項">
                        <MenuItem Header="開機啟動" x:Name="AutorunMenuItem" IsCheckable="True" IsChecked="{Binding isAutorun}" Click="AutorunMenuItem_Click"/>
                        <Separator/>
                        <MenuItem Header="關閉視窗" Click="CloseWindowMenuItem_Click"/>
                        <MenuItem Header="結束程式" Click="CloseAppMenuItem_Click"/>
                    </MenuItem>
                </Menu>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="24,0" x:Name="WorkspacePanes">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PreviewColumn" Width="0.85*" MinWidth="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition x:Name="RulesColumn" Width="1.35*" MinWidth="400"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding WorkspaceNotice}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,8">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <Controls:MonitorLayoutView Grid.Row="1" x:Name="MonitorLayout" ItemsSource="{Binding monitorInfos}"
                                            SelectedMonitorId="{Binding selectedMonitorId, Mode=TwoWay}"
                                            TunnelsSource="{Binding tunnelInfos}" SelectedTunnel="{Binding selectedTunnel, Mode=TwoWay}"
                                            ForceForbidEdge="{Binding forceForbidEdgeChecked}"/>
                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,12,0,0" Padding="14,6">
                    <Expander x:Name="MonitorInformation" Header="螢幕資訊" Foreground="{DynamicResource TextBrush}">
                        <StackPanel>
                            <TextBlock Text="由 Windows 偵測 · 選取可對照左側預覽" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <ListView x:Name="MonitorInfoListView" ItemsSource="{Binding monitorInfos}" MaxHeight="156"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource SummaryListItem}"
                                      SelectionMode="Single" SelectedValuePath="id" SelectedValue="{Binding selectedMonitorId, Mode=TwoWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding scaling, StringFormat='縮放比例 {0:0.##%;-;-}'}" FontSize="12"/>
                                                <TextBlock Text="{Binding id, Converter={StaticResource MonitorNumberConverter}, StringFormat='螢幕 {0}'}" FontWeight="SemiBold"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Converter={StaticResource MonitorDescriptionConverter}}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0">
                                                <Run Text="上 "/><Run Text="{Binding top, Mode=OneWay}"/><Run Text=" · 下 "/><Run Text="{Binding bottom, Mode=OneWay}"/>
                                                <Run Text=" · 左 "/><Run Text="{Binding left, Mode=OneWay}"/><Run Text=" · 右 "/><Run Text="{Binding right, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Expander>
                </Border>
            </Grid>
            <GridSplitter x:Name="WorkspaceSplitter" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" Focusable="True"
                          FocusVisualStyle="{StaticResource KeyboardFocus}" ToolTip="拖曳調整預覽與規則寬度" AutomationProperties.Name="調整預覽與規則寬度">
                <GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Border Background="{TemplateBinding Background}"><Border Width="3" Height="40" CornerRadius="2" Background="{DynamicResource BorderBrush}"/></Border></ControlTemplate></GridSplitter.Template>
            </GridSplitter>
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions>
                    <Grid x:Name="RuleHeader" Margin="16,12,16,10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Click="ConnectMonitorsButton_Click" IsEnabled="{Binding CanConnectMonitors}" Content="連接螢幕" Style="{StaticResource PrimaryButton}" Padding="10,6" MinHeight="32" Margin="8,0,0,0"/>
                            <Button DockPanel.Dock="Right" Click="AddTunnelInfoButton_Click" IsEnabled="{Binding CanAddRule}" Content="＋ 空白規則" Padding="10,6" MinHeight="32"/>
                            <TextBlock Text="通道規則" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{Binding ValidationSummary}" Margin="0,5,0,0" TextWrapping="Wrap">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding HasOverlapWarnings}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding HasValidationErrors}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid Grid.Row="1" x:Name="RuleWorkspace" Margin="12,0,12,12" SizeChanged="RuleWorkspace_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="210"/><Style.Triggers><DataTrigger Binding="{Binding IsCompactEditor}" Value="True"><Setter Property="Width" Value="*"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
                            <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="12"/><Style.Triggers><DataTrigger Binding="{Binding IsCompactEditor}" Value="True"><Setter Property="Width" Value="0"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
                            <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="*"/><Style.Triggers><DataTrigger Binding="{Binding IsCompactEditor}" Value="True"><Setter Property="Width" Value="0"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="*"/><Style.Triggers><DataTrigger Binding="{Binding IsCompactEditor}" Value="True"><Setter Property="Height" Value="108"/></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition>
                            <RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsCompactEditor}" Value="True"><Setter Property="Height" Value="10"/></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition>
                            <RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsCompactEditor}" Value="True"><Setter Property="Height" Value="*"/></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition>
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource SidebarBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <ListView x:Name="TunnelInfoListView" ItemsSource="{Binding tunnelInfos}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ItemContainerStyle="{StaticResource SummaryListItem}" SelectionMode="Single" SelectedItem="{Binding selectedTunnel, Mode=TwoWay}"
                                          SelectionChanged="TunnelInfoListView_SelectionChanged" AutomationProperties.Name="通道規則摘要">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ToolTip="{Binding TargetCaption}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="5" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding id}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding LocationCaption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ActionCaption}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsTransport}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding HasErrors}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource DeleteButton}" Click="TunnelInfoRemoveButton_Click" Content="刪除" FontSize="11" Padding="5,4" Margin="4,0,0,0" AutomationProperties.Name="{Binding id, StringFormat='刪除通道 {0}'}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="尚無通道規則" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding tunnelInfos.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Grid x:Name="RuleEditor">
                            <Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="2"/><Style.Triggers><DataTrigger Binding="{Binding IsCompactEditor}" Value="True"><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.Row" Value="2"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                            <TextBlock Text="選取一條規則以編輯，也可以點選預覽上的通道。" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding selectedTunnel}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <Grid>
                                <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding selectedTunnel}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="{Binding selectedTunnel.id, StringFormat='編輯通道 {0}'}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ScrollViewer Grid.Row="1" x:Name="RuleEditorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding selectedTunnel.ValidationMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding selectedTunnel.WarningMessage}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger><DataTrigger Binding="{Binding selectedTunnel.HasErrors}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel x:Name="RuleFields" DataContext="{Binding selectedTunnel, ValidatesOnNotifyDataErrors=False}">
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="來源螢幕" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                                    <ComboBox ItemsSource="{Binding DataContext.monitorInfos, ElementName=WorkspaceRoot}" SelectedValuePath="id" SelectedValue="{Binding displayID}" AutomationProperties.Name="規則來源螢幕">
                                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding id, Converter={StaticResource MonitorNumberConverter}, StringFormat='螢幕 {0}'}"/></DataTemplate></ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="觸發邊緣" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                                    <ComboBox ItemsSource="{Binding Source={StaticResource NameFromEdgeTypeEnum}}" SelectedItem="{Binding edgeType}" AutomationProperties.Name="觸發邊緣">
                                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EditorOptionLabelConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="通道範圍" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                            <ComboBox ItemsSource="{Binding Source={StaticResource NameFromRangeTypeEnum}}" SelectedItem="{Binding rangeType}" Margin="0,0,0,10" AutomationProperties.Name="通道範圍模式">
                                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EditorOptionLabelConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsRangeEditable}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="{Binding StartLabel, StringFormat='{}{0} (px)'}" Style="{StaticResource Caption}" Margin="0,0,0,6"/><TextBox Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" ToolTip="{Binding FieldHelp}" AutomationProperties.Name="起點設定"/></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="{Binding ExtentLabel, StringFormat='{}{0} (px)'}" Style="{StaticResource Caption}" Margin="0,0,0,6"/><TextBox Text="{Binding ExtentText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" ToolTip="{Binding FieldHelp}" AutomationProperties.Name="長度或終點內縮"/></StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding RangeHint}" TextWrapping="Wrap" Margin="0,0,0,18">
                                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding HasErrors}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="經過時的動作" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                                    <ComboBox ItemsSource="{x:Static Editing:EditorOptions.Actions}" DisplayMemberPath="Caption" SelectedValuePath="Value" SelectedValue="{Binding IsTransport}" AutomationProperties.Name="經過時的動作"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="目標通道" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                                    <ComboBox SelectedValuePath="id" SelectedValue="{Binding relativeID}" IsEnabled="{Binding IsTransport}" ToolTip="{Binding SelectedItem.TargetCaption, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="目標通道">
                                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding TargetCaption}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                                                        <ComboBox.Resources><CollectionViewSource x:Key="IdCollection" Source="{Binding DataContext.tunnelInfos, ElementName=WorkspaceRoot}"/></ComboBox.Resources>
                                                        <ComboBox.ItemsSource><CompositeCollection><CollectionContainer Collection="{Binding DefaultTunnelInfos, Source={StaticResource TunnelInfo_Notify}}"/><CollectionContainer Collection="{Binding Source={StaticResource IdCollection}}"/></CompositeCollection></ComboBox.ItemsSource>
                                                        <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="Visibility"><Setter.Value><MultiBinding Converter="{StaticResource RelativeIdValidMultiValueConverter}"><Binding Path="id"/><Binding RelativeSource="{RelativeSource Self}"/></MultiBinding></Setter.Value></Setter></Style></ComboBox.ItemContainerStyle>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,0">
                        <CheckBox x:Name="ForceForbidEdgeCheckbox" IsChecked="{Binding forceForbidEdgeChecked, Mode=TwoWay}" Content="封鎖未設定通道的螢幕邊緣" VerticalAlignment="Center" ToolTip="只允許游標經由已設定的通道通行"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="24,16,24,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="IsStartButton" IsEnabled="{Binding CanStartStop}" Style="{StaticResource PrimaryButton}" Click="StartStopButton_Click" Content="{Binding isStart, Converter={StaticResource IsStartConverter}}" MinWidth="90"/>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="{Binding EditStatus}" FontSize="12"/>
                    <TextBlock Text="關閉視窗會保留草稿" Style="{StaticResource Caption}" FontSize="11"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="ResetButton_Click" Style="{StaticResource QuietButton}" Content="重新載入" ToolTip="重新載入設定檔；尚無檔案時清空規則並關閉邊緣封鎖" Margin="0,0,8,0"/>
                <Button Click="ApplyButton_Click" IsEnabled="{Binding CanApply}" ToolTipService.ShowOnDisabled="True" Content="套用" ToolTip="{Binding ValidationSummary}" Margin="0,0,8,0"/>
                <Button Click="SaveSettingButton_Click" IsEnabled="{Binding CanApply}" ToolTipService.ShowOnDisabled="True" Style="{StaticResource PrimaryButton}" Content="儲存設定" ToolTip="{Binding ValidationSummary}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
