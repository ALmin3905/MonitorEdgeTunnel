<Window x:Class="MonitorEdgeTunnelApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        xmlns:Local="clr-namespace:MonitorEdgeTunnelApp"
        xmlns:Controls="clr-namespace:MonitorEdgeTunnelApp.Controls"
        xmlns:Editing="clr-namespace:MonitorEdgeTunnelApp.Editing"
        mc:Ignorable="d"
        Title="螢幕邊界助手" Height="780" Width="1280" MinHeight="600" MinWidth="860"
        Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Resources/monitor.ico">
    <Window.Resources>
        <ObjectDataProvider x:Key="NameFromEdgeTypeEnum" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="Local:EdgeType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="NameFromRangeTypeEnum" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="Local:RangeType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <Local:TunnelInfo_Notify x:Key="TunnelInfo_Notify"/>
        <Local:RelativeIdValidMultiValueConverter x:Key="RelativeIdValidMultiValueConverter"/>
        <Local:IsStartConverter x:Key="IsStartConverter"/>
        <Editing:EditorOptionLabelConverter x:Key="EditorOptionLabelConverter"/>
        <Controls:MonitorNumberConverter x:Key="MonitorNumberConverter"/>
    </Window.Resources>
    <Grid Background="{DynamicResource AppBackgroundBrush}" TextElement.Foreground="{DynamicResource TextBrush}"
          TextElement.FontFamily="Segoe UI, Microsoft JhengHei UI" TextElement.FontSize="13">
        <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="24,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MONITOR EDGE TUNNEL" Style="{StaticResource Caption}" FontSize="10" Margin="0,0,0,5"/>
                <TextBlock Text="螢幕與通道" FontSize="22" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="12" Background="{DynamicResource SidebarBrush}" Padding="10,5" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource MutedTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding isStart}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="尚未啟動"/><Style.Triggers><DataTrigger Binding="{Binding isStart}" Value="True"><Setter Property="Text" Value="通道運作中"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </StackPanel>
                </Border>
                <Menu VerticalAlignment="Center">
                    <MenuItem Header="選項">
                        <MenuItem Header="開機啟動" x:Name="AutorunMenuItem" IsCheckable="True" IsChecked="{Binding isAutorun}" Click="AutorunMenuItem_Click"/>
                        <Separator/>
                        <MenuItem Header="關閉視窗" Click="CloseWindowMenuItem_Click"/>
                        <MenuItem Header="結束程式" Click="CloseAppMenuItem_Click"/>
                    </MenuItem>
                </Menu>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="24,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding WorkspaceNotice}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,6">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            <Controls:MonitorLayoutView Grid.Row="1" x:Name="MonitorLayout" ItemsSource="{Binding monitorInfos}"
                                        SelectedMonitorId="{Binding selectedMonitorId, Mode=TwoWay}"
                                        TunnelsSource="{Binding tunnelInfos}" SelectedTunnel="{Binding selectedTunnel, Mode=TwoWay}"
                                        ForceForbidEdge="{Binding forceForbidEdgeChecked}"/>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="0.32*" MinHeight="126" MaxHeight="166"/><RowDefinition Height="16"/><RowDefinition Height="0.68*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                    <Grid Margin="0,12,0,8">
                        <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="16,0">
                            <TextBlock Text="螢幕資訊" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="由 Windows 偵測" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListView Grid.Row="1" Margin="0,4,0,0" x:Name="MonitorInfoListView" ItemsSource="{Binding monitorInfos}"
                                  SelectionMode="Single" SelectedValuePath="id" SelectedValue="{Binding selectedMonitorId, Mode=TwoWay}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="螢幕" Width="48" DisplayMemberBinding="{Binding id, Converter={StaticResource MonitorNumberConverter}}"/>
                                    <GridViewColumn Header="上" Width="52" DisplayMemberBinding="{Binding top}"/>
                                    <GridViewColumn Header="下" Width="60" DisplayMemberBinding="{Binding bottom}"/>
                                    <GridViewColumn Header="左" Width="66" DisplayMemberBinding="{Binding left}"/>
                                    <GridViewColumn Header="右" Width="66" DisplayMemberBinding="{Binding right}"/>
                                    <GridViewColumn Header="縮放比例" Width="96" DisplayMemberBinding="{Binding scaling, StringFormat={}{0:0.##%;-;-}}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="60"/></Grid.RowDefinitions>
                        <DockPanel x:Name="RuleHeader" Margin="16,0" VerticalAlignment="Center">
                            <Button DockPanel.Dock="Right" Click="ConnectMonitorsButton_Click" IsEnabled="{Binding CanConnectMonitors}" Content="連接螢幕" Padding="10,6" MinHeight="32" Margin="8,0,0,0"/>
                            <Button DockPanel.Dock="Right" Click="AddTunnelInfoButton_Click" IsEnabled="{Binding CanAddRule}" Content="＋ 新增通道" Padding="10,6" MinHeight="32"/>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="通道規則" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding ValidationSummary}" Margin="0,3,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding HasOverlapWarnings}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding HasValidationErrors}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                        </DockPanel>
                        <ListView Grid.Row="1" x:Name="TunnelInfoListView" ItemsSource="{Binding tunnelInfos}" AlternationCount="{Binding tunnelInfos.Count}"
                                      SelectionMode="Single" SelectedItem="{Binding selectedTunnel, Mode=TwoWay}" SelectionChanged="TunnelInfoListView_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="刪除" Width="auto">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource DeleteButton}" Click="TunnelInfoRemoveButton_Click">刪除</Button>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="ID" Width="auto" DisplayMemberBinding="{Binding id}"/>
                                        <GridViewColumn Header="螢幕" Width="auto">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListView}}, Path=DataContext.monitorInfos}" SelectedValuePath="id" SelectedValue="{Binding displayID}" Width="54">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding id, Converter={StaticResource MonitorNumberConverter}}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="邊緣" Width="auto">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding Source={StaticResource NameFromEdgeTypeEnum}}" SelectedItem="{Binding edgeType}" Width="68">
                                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EditorOptionLabelConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="通道類型" Width="auto">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding Source={StaticResource NameFromRangeTypeEnum}}" SelectedItem="{Binding rangeType}" Width="94">
                                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EditorOptionLabelConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="區段設定 (px)" Width="184">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <TextBlock Text="使用整個邊緣" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center">
                                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsRangeEditable}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                        </TextBlock>
                                                        <StackPanel Orientation="Horizontal">
                                                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsRangeEditable}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                            <StackPanel Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding StartLabel}" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                                                <TextBox Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="78" ToolTip="{Binding FieldHelp}" AutomationProperties.Name="起點設定"/>
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding ExtentLabel}" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                                                <TextBox Text="{Binding ExtentText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="78" ToolTip="{Binding FieldHelp}" AutomationProperties.Name="長度或終點內縮"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="動作與目標" Width="126">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <ComboBox ItemsSource="{x:Static Editing:EditorOptions.Actions}" DisplayMemberPath="Caption" SelectedValuePath="Value" SelectedValue="{Binding IsTransport}" Width="110"/>
                                                    <ComboBox SelectedValuePath="id" SelectedValue="{Binding relativeID}" Width="110" Margin="0,4,0,0" IsEnabled="{Binding IsTransport}" ToolTip="{Binding SelectedItem.TargetCaption, RelativeSource={RelativeSource Self}}">
                                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding TargetCaption}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                                                        <ComboBox.Resources>
                                                            <CollectionViewSource x:Key="IdCollection" Source="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListView}}, Path=DataContext.tunnelInfos}"/>
                                                        </ComboBox.Resources>
                                                        <ComboBox.ItemsSource>
                                                            <CompositeCollection>
                                                                <CollectionContainer Collection="{Binding DefaultTunnelInfos, Source={StaticResource TunnelInfo_Notify}}"/>
                                                                <CollectionContainer Collection="{Binding Source={StaticResource IdCollection}}"/>
                                                            </CompositeCollection>
                                                        </ComboBox.ItemsSource>
                                                        <ComboBox.ItemContainerStyle>
                                                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                                <Setter Property="Visibility">
                                                                    <Setter.Value>
                                                                        <MultiBinding Converter="{StaticResource RelativeIdValidMultiValueConverter}">
                                                                            <Binding Path="id"/>
                                                                            <Binding RelativeSource="{RelativeSource Self}"/>
                                                                        </MultiBinding>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ComboBox.ItemContainerStyle>
                                                    </ComboBox>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}" Padding="14,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding selectedTunnel}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <StackPanel Width="{Binding ActualWidth, ElementName=RuleHeader}">
                                <TextBlock Text="{Binding selectedTunnel.ValidationMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="12">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding selectedTunnel.WarningMessage}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="12">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger><DataTrigger Binding="{Binding selectedTunnel.HasErrors}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding selectedTunnel.RangeHint}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding selectedTunnel.HasErrors}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                            <StackPanel VerticalAlignment="Center">
                                <CheckBox x:Name="ForceForbidEdgeCheckbox" IsChecked="{Binding forceForbidEdgeChecked, Mode=TwoWay}" Content="封鎖未設定通道的螢幕邊緣"/>
                                <TextBlock Text="只允許游標經由已設定的通道通行" Style="{StaticResource Caption}" Margin="26,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="24,16,24,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="IsStartButton" IsEnabled="{Binding CanStartStop}" Style="{StaticResource PrimaryButton}" Click="StartStopButton_Click" Content="{Binding isStart, Converter={StaticResource IsStartConverter}}" MinWidth="90"/>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="{Binding EditStatus}" FontSize="12"/>
                    <TextBlock Text="關閉視窗會保留草稿" Style="{StaticResource Caption}" FontSize="11"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="ResetButton_Click" Style="{StaticResource QuietButton}" Content="重新載入" ToolTip="重新載入設定檔，捨棄目前配置未儲存的內容" Margin="0,0,8,0"/>
                <Button Click="ApplyButton_Click" IsEnabled="{Binding CanApply}" ToolTipService.ShowOnDisabled="True" Content="套用" ToolTip="{Binding ValidationSummary}" Margin="0,0,8,0"/>
                <Button Click="SaveSettingButton_Click" IsEnabled="{Binding CanApply}" ToolTipService.ShowOnDisabled="True" Style="{StaticResource PrimaryButton}" Content="儲存設定" ToolTip="{Binding ValidationSummary}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
