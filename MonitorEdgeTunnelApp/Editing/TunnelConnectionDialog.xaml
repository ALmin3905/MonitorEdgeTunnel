<Window x:Class="MonitorEdgeTunnelApp.Editing.TunnelConnectionDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        xmlns:Local="clr-namespace:MonitorEdgeTunnelApp"
        xmlns:Controls="clr-namespace:MonitorEdgeTunnelApp.Controls"
        xmlns:Editing="clr-namespace:MonitorEdgeTunnelApp.Editing"
        Title="連接螢幕" Width="460" SizeToContent="Height" MaxHeight="600" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
    <Window.Resources>
        <Controls:MonitorNumberConverter x:Key="MonitorNumber"/>
        <Editing:EditorOptionLabelConverter x:Key="OptionLabel"/>
        <ObjectDataProvider x:Key="Edges" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters><x:Type TypeName="Local:EdgeType"/></ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <DataTemplate x:Key="MonitorLabel"><TextBlock><Run Text="螢幕 "/><Run Text="{Binding id, Converter={StaticResource MonitorNumber}, Mode=OneWay}"/></TextBlock></DataTemplate>
        <DataTemplate x:Key="EdgeLabel"><TextBlock Text="{Binding Converter={StaticResource OptionLabel}}"/></DataTemplate>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="連接兩個螢幕邊緣" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="先建立完整邊緣，再於規則中調整通道範圍。" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="從這裡出發" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Monitors}" ItemTemplate="{StaticResource MonitorLabel}" SelectedValuePath="id" SelectedValue="{Binding SourceMonitorId}" AutomationProperties.Name="來源螢幕"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding Source={StaticResource Edges}}" ItemTemplate="{StaticResource EdgeLabel}" SelectedItem="{Binding SourceEdge}" AutomationProperties.Name="來源邊緣"/>
                </Grid>
                <TextBlock Text="傳送到" Style="{StaticResource Caption}" Margin="0,20,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Monitors}" ItemTemplate="{StaticResource MonitorLabel}" SelectedValuePath="id" SelectedValue="{Binding TargetMonitorId}" AutomationProperties.Name="目標螢幕"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding Source={StaticResource Edges}}" ItemTemplate="{StaticResource EdgeLabel}" SelectedItem="{Binding TargetEdge}" AutomationProperties.Name="目標邊緣"/>
                </Grid>
                <CheckBox Content="同時建立返回通道（雙向）" IsChecked="{Binding Bidirectional}" Margin="0,24,0,8"/>
                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="取消" IsCancel="True" IsDefault="True" MinWidth="80" Margin="0,0,8,0"/>
            <Button Content="建立通道" IsEnabled="{Binding CanCreate}" Style="{StaticResource PrimaryButton}" Click="CreateButton_Click" MinWidth="100"/>
        </StackPanel>
    </Grid>
</Window>
